# Copia este archivo a server/.env (está fuera de git) y llena los valores.
# PostgreSQL 12+ con las extensiones citext y vector (pgvector)
NAO_DB_URL=postgres://nao:CAMBIAR@127.0.0.1:5432/nao
NAO_ADDR=127.0.0.1:3030
# Hosts desde los que se permite abrir los WebSocket (tu dominio y localhost)
NAO_ALLOWED_ORIGINS=localhost,127.0.0.1
# Clave de Gemini (https://aistudio.google.com): mejor pasarla por entorno al arrancar que dejarla aquí
GEMINI_API_KEY=
# Mundo compartido: vacíos = sala dentro de nao-api (plan B). Con el Worker de world/: su URL wss y el mismo secreto
NAO_WORLD_URL=
NAO_WORLD_SECRET=
# Opcionales (modelos de Gemini y precio de la transcripción): ver los valores por defecto en server/*.go
# NAO_BRAIN_MODEL=
# NAO_BRAIN_CHAT_MODEL=
# NAO_TRANSCRIBE_USD_PER_MIN=
